{
  "name": "ticket-system",
  "version": "1.1.1",
  "description": "Simple server-rendered ticketing system with Fastify",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev:db": "node scripts/dev-database.js",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "dev:setup": "node --env-file-if-exists=.env.local scripts/dev-setup.js",
    "dev:doctor": "node --env-file-if-exists=.env.local scripts/dev-doctor.js",
    "dev:smoke": "node --env-file-if-exists=.env.local scripts/dev-smoke.js",
    "admin:password": "node --env-file-if-exists=.env.local scripts/admin-password.js",
    "build": "node scripts/check-js-syntax.js",
    "build:materializer": "cargo build --release --manifest-path native/process-materializer/Cargo.toml",
    "fmt:materializer": "cargo fmt --manifest-path native/process-materializer/Cargo.toml -- --check",
    "lint:materializer": "cargo clippy --manifest-path native/process-materializer/Cargo.toml --all-targets -- -D warnings",
    "test:materializer": "node scripts/process-materializer-native-test.js && node scripts/process-materializer-contract-test.js && node scripts/process-materializer-deployment-test.js && node scripts/process-materializer-linux-test.js && node scripts/process-materializer-cross-uid-test.js",
    "build:launcher-foundation": "cargo build --release --manifest-path native/process-launcher/Cargo.toml",
    "fmt:launcher-foundation": "cargo fmt --manifest-path native/process-launcher/Cargo.toml -- --check",
    "lint:launcher-foundation": "cargo clippy --manifest-path native/process-launcher/Cargo.toml --all-targets -- -D warnings",
    "test:launcher-foundation": "node scripts/process-launcher-foundation-native-test.js && node scripts/process-launcher-foundation-contract-test.js && node scripts/process-launcher-foundation-deployment-test.js && node scripts/process-launcher-foundation-cross-uid-test.js",
    "test:launcher-containment": "PROCESS_CONTAINMENT_ACTIVE_REQUIRED=1 node scripts/process-launcher-foundation-cross-uid-test.js",
    "test:process-runtime": "node scripts/process-runtime-capability-test.js && node scripts/process-output-artifact-test.js && node scripts/process-runtime-fault-recovery-test.js && node scripts/process-supervision-contract-test.js && node scripts/process-runtime-lifecycle-postgres-test.js && node scripts/process-runtime-dispatch-postgres-test.js && node scripts/process-supervision-postgres-test.js && node scripts/process-lease-expiry-cancellation-postgres-test.js && node scripts/process-consequence-reconstruction-test.js",
    "preview": "NODE_ENV=production node server.js",
    "codex:bootstrap": "node scripts/codex-bootstrap.js",
    "codex:trace": "node scripts/codex-trace.js",
    "codex:verify": "node scripts/codex-verify.js",
    "test:admission": "node scripts/mutation-admission-contract-test.js && node scripts/mutation-admission-scheduler-test.js",
    "test:scheduler": "node scripts/scheduler-observability-test.js",
    "test:objective": "node scripts/objective-contract-parity-test.js && node scripts/objective-contract-compiler-test.js",
    "test:persistence:contract": "node scripts/postgres-persistence-contract-test.js",
    "test:persistence:postgres": "node scripts/postgres-persistence-integration-test.js",
    "test:cutover:postgres": "node scripts/postgres-runtime-cutover-test.js",
    "test:page-render:postgres": "node scripts/page-render-regression-test.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/postgres-migrate.js",
    "checkpoint:release": "node scripts/release-checkpoint.js",
    "test": "npm run checkpoint:release"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/session": "^11.1.1",
    "@fastify/view": "^11.1.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "fastify": "^5.8.5",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1"
  },
  "keywords": [
    "tickets",
    "fastify",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0"
}
