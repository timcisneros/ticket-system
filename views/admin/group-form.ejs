<h1><%= editGroup ? 'Edit Group' : 'New Group' %></h1>

<% if (error) { %>
  <div class="error-message"><%= error %></div>
<% } %>

<form action="<%= editGroup ? '/admin/groups/' + editGroup.id : '/admin/groups' %>" method="POST" class="ticket-form">
  <% if (editGroup) { %><input type="hidden" name="revision" value="<%= editGroup.revision %>"><% } %>
  <div class="form-group">
    <label for="name">Group Name *</label>
    <input type="text" id="name" name="name" value="<%= editGroup ? editGroup.name : '' %>" required>
  </div>

  <label class="checkbox-label">
    <input type="checkbox" name="canReceiveTickets" <%= editGroup && editGroup.canReceiveTickets ? 'checked' : '' %>>
    Can receive tickets
  </label>

  <div class="form-group">
    <label for="plannerAgentId">Structured-allocation planner</label>
    <% if (editGroup) { %>
      <select id="plannerAgentId" name="plannerAgentId">
        <option value="">No planner designated</option>
        <% groupAgents.forEach(function(agent) { %>
          <option value="<%= agent.id %>" <%= editGroup.plannerAgentId === agent.id ? 'selected' : '' %>><%= agent.name %> — <%= agent.provider %>/<%= agent.model || 'model not configured' %></option>
        <% }); %>
      </select>
      <p class="form-hint">The planner must remain a current group member. Provider and model come from this configured agent and are snapshotted when explicit parent work is admitted.</p>
    <% } else { %>
      <p class="form-hint">Create the group, add an agent member, then edit the group to designate its planner. No member is selected implicitly.</p>
    <% } %>
  </div>

  <div class="form-group">
    <label>Permissions</label>
    <div class="permission-grid">
      <% allPermissions.forEach(function(permission) { %>
        <label class="checkbox-label permission-checkbox">
          <input type="checkbox" name="permissions" value="<%= permission %>" 
            <%= groupPermissions.includes(permission) ? 'checked' : '' %>>
          <code><%= permission %></code>
        </label>
      <% }); %>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn-submit"><%= editGroup ? 'Update Group' : 'Create Group' %></button>
    <a href="/admin" class="btn-secondary">Cancel</a>
  </div>
</form>
