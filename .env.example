# Prefer `pnpm dev:setup`; manual copies are also supported. Never commit real credentials.
DATABASE_URL=postgresql://ticket_system:ticket_system@127.0.0.1:5432/ticket_system
SESSION_SECRET=replace-with-at-least-32-random-characters

# Creation-only, minimum 12 characters. Ignored after the initial admin exists.
# Interactive `pnpm dev:setup` prompts securely instead of storing this value.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-development-password

# Optional PostgreSQL namespace override.
# POSTGRES_SCHEMA=ticket_system

# Provider settings for the initial runnable agent. Configure OpenAI or Ollama.
# DEV_AGENT_PROVIDER=ollama
# DEV_AGENT_NAME=Developer Agent
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Install and start Ollama, then run: ollama pull <model>
# OLLAMA_MODEL=<exact-installed-tag>
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Process execution is installed and admission-disabled by default. A production
# release supplies its exact committed revision and only sets deployment validation
# after the checked-in multi-UID/deployment gate has passed. PostgreSQL admission is
# then enabled separately with `npm run release:admission -- enable ...`.
# ENABLE_PROCESS_EXECUTION_CONTRACT=false
# PROCESS_EXECUTION_SOURCE_REVISION=<exact-40-character-commit>
# PROCESS_EXECUTION_DEPLOYMENT_VALIDATED=false
