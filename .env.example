# Parity note: this file teaches the canonical registry
# (runtime/environment-config-registry.js). It is not the authority: the
# registry owns supported settings, validation, development/production
# defaults, and secret classification, and the owning contract test proves
# this file stays in parity with it. Never commit real credentials.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ticket_system:ticket_system@127.0.0.1:5432/ticket_system
SESSION_SECRET=replace-with-at-least-32-random-characters

# Creation-only, minimum 12 characters. Ignored after the initial admin exists.
# Interactive `pnpm dev:setup` prompts securely instead of storing this value.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-development-password

# ── Optional deployment configuration ─────────────────────────────────────
# POSTGRES_SCHEMA=ticket_system
# WORKSPACE_ROOT=workspace-root
# ARTIFACT_ROOT=.local-artifacts
# PORT=3099
# SESSION_PURGE_INTERVAL_MS=60000
# SESSION_PURGE_BATCH_SIZE=1000

# Deployment-wide work capacity (capacity is load state; it never changes
# health readiness). Defaults: MAX_ACTIVE_RUNS 32, MAX_ACTIVE_RUNS_CAP 4096,
# LOCAL_MODEL_CONCURRENCY 1, MAX_LOCAL_MODEL_CONCURRENCY 32.
# MAX_ACTIVE_RUNS=32
# MAX_ACTIVE_RUNS_CAP=4096
# LOCAL_MODEL_CONCURRENCY=1
# MAX_LOCAL_MODEL_CONCURRENCY=32

# ── Provider settings for the initial runnable agent ──────────────────────
# Configure OpenAI or Ollama.
# DEV_AGENT_PROVIDER=ollama
# DEV_AGENT_NAME=Developer Agent
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Install and start Ollama, then run: ollama pull <model>
# OLLAMA_MODEL=<exact-installed-tag>
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Process execution (installed and admission-disabled by default) ───────
# A production release supplies its exact committed revision and only sets
# deployment validation after the checked-in multi-UID/deployment gate has
# passed. PostgreSQL admission is then enabled separately with
# `npm run release:admission -- enable ...`.
# ENABLE_PROCESS_EXECUTION_CONTRACT=false
# PROCESS_EXECUTION_SOURCE_REVISION=<exact-40-character-commit>
# PROCESS_EXECUTION_DEPLOYMENT_VALIDATED=false

# Model-assisted objective compilation stays opt-in (adds a provider request
# before direct execution).
# ENABLE_MODEL_CONTRACT_COMPILER=false
