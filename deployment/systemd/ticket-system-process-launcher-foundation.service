[Unit]
Description=Ticket System trusted process launcher foundation
After=local-fs.target
ConditionPathIsDirectory=/run/ticket-system-process/launcher
ConditionPathIsDirectory=/var/lib/ticket-system/process-launcher
ConditionPathIsDirectory=/var/lib/ticket-system/runtime-rootfs
ConditionPathExists=/etc/ticket-system/process-launcher-foundation.json
ConditionPathExists=/etc/ticket-system/process-seccomp-v1.json

[Service]
Type=simple
User=ticket-system-launcher
Group=ticket-system-process-handoff
SupplementaryGroups=ticket-system-runtime
ExecStart=/usr/libexec/ticket-system/ticket-system-process-launcher-foundation /etc/ticket-system/process-launcher-foundation.json
Environment=LANG=C.UTF-8
UMask=0027
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=15s
Delegate=cpu memory pids
TasksMax=infinity
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/usr/bin/bwrap
ReadOnlyPaths=/etc/ticket-system/process-launcher-foundation.json
ReadOnlyPaths=/etc/ticket-system/process-seccomp-v1.json
ReadOnlyPaths=/var/lib/ticket-system/runtime-rootfs
ReadWritePaths=/run/ticket-system-process/launcher
ReadWritePaths=/var/lib/ticket-system/process-launcher
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true

[Install]
WantedBy=multi-user.target
